# Copy this file to .env.local. It is read only by the independent content-workbench bridge.
# Do not add these values to MediaCrawler configuration.
#
# Create an API key after enabling Doubao Voice's Recording File Recognition service.
DOUBAO_ASR_API_KEY=
# The downloaded-assets folder must be published to an HTTPS address that Doubao can reach.
# The bridge will submit a token-protected /public-audio URL under this HTTPS base.
DOUBAO_ASR_PUBLIC_BASE_URL=
# Required random token. Keep this local and do not share it.
DOUBAO_ASR_PUBLIC_TOKEN=
# Optional. Default is the Doubao Recording File Recognition 2.0 resource.
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.auc

# Current DeepSeek text model used for rewrite generation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Zhipu CogView cover generation.
ZHIPU_API_KEY=
ZHIPU_IMAGE_MODEL=cogview-3-flash

# When the frontend is hosted on GitHub Pages, point it to the public HTTPS URL
# of the combined content-workbench server. This URL is public; API keys stay
# only on the server and must never be added to VITE_* variables.
VITE_BACKEND_BASE_URL=

# Comma-separated browser origins allowed to call a public combined server.
# For this repository use: https://sheckham1986.github.io
CONTENT_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
